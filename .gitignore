# Xcode
*.xcodeproj
*.xcworkspace
build/

# 例外: 原版 APK 的基线文件就放在 www/build/ 下, build/ 规则会把它一起吃掉 ——
# apkshadow 闸门在 CI 上因此读不到基线直接崩 (本地有文件所以一直没暴露)。
!vendor/apk-baseline/www/build/
DerivedData/
xcuserdata/
*.ipa

# macOS / Node
.DS_Store
node_modules/

# 审计跑批草稿 (工具输出、.bak、msg-*.txt)，不是版本库内容
state/

# 并行子代理的隔离 worktree (不是版本库内容)
.qoder/

# CI 抓取临时文件 (本地核对用, 不入库)
.ci-tmp*/
.ci-tmp*.html
.ci-w/
.job-new.html
.job*.html
.run-new.html
.run-list.html
.r[0-9]*.html
.api-run.json

# WorkBuddy 项目数据 (非版本库内容)
.workbuddy-ai/

# 会话期临时脚本/抓取物 (用完即删; 根目录专用, 防误入库)
/_*.py
/_*.sh
/_*.log
/_*.json
/_*.txt
e6.txt
e7.txt
w.txt
wc.txt

# tools/kotlinlocal.js 的临时输出 (本地编译通道, 每次跑都重建)
.kotlinlocal/
