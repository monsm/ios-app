{
  "$comment": [
    "逻辑面差分规则表 (tools/logicparity.js 读)。数据面(golden.json/cmdsshadow)管\"发出去的字节\",",
    "这张表管**时序与流程**: 分片与写确认、超时与重试、令牌刷新时机、rc 自愈、多帧采集窗口、串行化。",
    "每条规则两侧都要有证据: apk = 反编译产物 (Java 原生层 / APK 的 JS 层, 后者已逐字移植到 vendor/app),",
    "impl = 本机 (iOS Swift / 小程序 JS)。kind=parity 表示两侧必须表达同一逻辑; kind=divergence 表示",
    "**已裁定的有意分歧** —— 两侧各自对得上自己的证据才算通过, 但会在报告里单列, 不许悄悄消失。",
    "file 路径相对**本仓库根** (ios-app/); APK 反编译证据已随仓库收录在 vendor/apk/, 小程序侧 JS 与 vendor/app/ 同源同步。re 是对该文件全文的 JS 正则。"
  ],
  "rules": [
    {
      "id": "L01-chunk-20",
      "kind": "parity",
      "title": "20B 分片上限",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "MAX_MTU = 20", "note": "Java 原生层 MAX_MTU" },
        { "file": "vendor/app/services/ble.js", "re": "const chunk = 20;", "note": "APK JS writeFrame" }
      ],
      "impl": [
        { "file": "App/Services/BLEService.swift", "re": "let chunk = 20", "note": "CoreBluetooth 逐片写" },
        { "file": "vendor/app/services/ble.js", "re": "const chunk = 20;", "note": "wx 逐片写" }
      ]
    },
    {
      "id": "L02-chunk-ack-8s",
      "kind": "parity",
      "title": "写确认按片计时 8s (不是整帧 3s)",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "BLE_TIMEOUT = 8000", "note": "每片 writeCharacteristic 后等 onCharacteristicWrite" }
      ],
      "impl": [
        { "file": "App/Services/BLEService.swift", "re": "deadline: \\.now\\(\\) \\+ 8\\.0, execute: work", "note": "writeChunk 的 ack 定时器" },
        { "file": "vendor/app/services/ble.js", "re": "> 8000\\)", "note": "每片独立 8s 窗口 (原 3s 整帧, 见 §逻辑面 D6)" }
      ]
    },
    {
      "id": "L03-rx-timeout-8s",
      "kind": "parity",
      "title": "响应超时 8s",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "receiveTimer\\.schedule", "note": "post() 之后起单次接收计时器" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "timeoutMs: Int = 8000", "note": "request 的默认窗口" },
        { "file": "vendor/app/services/lock.js", "re": "timeout: 8000, retries: 3", "note": "_request 默认 opts" }
      ]
    },
    {
      "id": "L04-retries-3",
      "kind": "parity",
      "title": "命令重试 3 次",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "BLE_Retry_Times = 3", "note": "Java 连接/命令重试基数" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "retries: Int = 3", "note": "exec/execOk 默认" },
        { "file": "vendor/app/services/lock.js", "re": "retries: 3, needToken: false", "note": "_request 默认" }
      ]
    },
    {
      "id": "L05-single-waiter",
      "kind": "parity",
      "title": "单 waiter 串行: 有命令在飞时拒绝第二条 (而不是覆盖)",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "private LockCommResponse sendToClient = null", "note": "单槽 + callbackSignal.command 状态机" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "guard let w = self\\.waiter, w\\.cmd == cmd else \\{ return \\}", "note": "陈旧的其它 cmd 定时器不误杀" },
        { "file": "vendor/app/services/lock.js", "re": "已有命令在等待响应", "note": "_waitFrame 忙判" }
      ]
    },
    {
      "id": "L06-writefail-clears-waiter",
      "kind": "parity",
      "title": "写失败即刻清掉自己那一格 waiter",
      "apk": [
        { "file": "vendor/app/services/ble.js", "re": "reject\\(withCode\\(err, 6005\\)\\)", "note": "APK JS 写失败即 reject" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "if let w = waiter, w\\.cmd == cmd \\{", "note": "只清同 cmd" },
        { "file": "vendor/app/services/lock.js", "re": "if \\(ww && ww\\.cmd === cmd\\)", "note": "按 cmd 清理" }
      ]
    },
    {
      "id": "L07-link-heal",
      "kind": "parity",
      "title": "断链识别 → 丢弃旧连接 → 下一轮自愈重连",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "onConnectionStateChange", "note": "state != 2 即视为断开并 notifyAll" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "var brokenLink = ble\\.connectedMAC\\.isEmpty", "note": "写失败/断链都走自愈" },
        { "file": "vendor/app/services/lock.js", "re": "10006|已断开", "note": "错误文案判定 → conn=null (原正则 /10006|disconnect|closed|已断开/i)" }
      ]
    },
    {
      "id": "L08-token-every-needing-cmd",
      "kind": "parity",
      "title": "每条 needToken 命令都**无条件**先取一次 01 (不按 TTL 跳过)",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "if \\(data\\.needSessionToken\\(\\)\\) \\{", "note": "→ doRefreshSsToken() 每命令一次" },
        { "file": "vendor/app/services/lock.js", "re": "Java 发送路径\\*\\*从不检查 isExpire\\(\\)\\*\\*", "note": "V81 勘误: 不缓存跳过" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "if needToken \\{\\s*try await ensureToken\\(\\)", "note": "request 内无条件" },
        { "file": "vendor/app/services/lock.js", "re": "if \\(o\\.needToken\\) \\{\\s*await this\\._ensureToken\\(\\);", "note": "同" }
      ]
    },
    {
      "id": "L09-token-ttl-margin-2s",
      "kind": "parity",
      "title": "令牌 TTL 只剩 2s 即视为过期 (Java isExpire: now+2s > expire)",
      "apk": [
        { "file": "vendor/app/utils/session.js", "re": "expiresAtMs - Date\\.now\\(\\)\\) > 2000", "note": "V80 (F3) 对齐 Java isExpire" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "Int64\\(secs\\) \\* 1000 \\+ 2000", "note": "tokenExpiryMs 记账口径" },
        { "file": "vendor/app/utils/session.js", "re": "expiresAtMs - Date\\.now\\(\\)\\) > 2000", "note": "同" }
      ]
    },
    {
      "id": "L10-rc3-refresh-once",
      "kind": "parity",
      "title": "rc=3 (命令过期) → 刷令牌重试一次, 仍 3 则不无限重试",
      "apk": [
        { "file": "vendor/app/services/lock.js", "re": "rc === 3 && o\\.needToken", "note": "G3 令牌过期自愈" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "if rc == 3 && needToken", "note": "refresh 后 retries: 1" },
        { "file": "vendor/app/services/lock.js", "re": "rc === 3 && o\\.needToken", "note": "同" }
      ]
    },
    {
      "id": "L11-rc-klv-map",
      "kind": "parity",
      "title": "rc 所在 KLV 键: 03/04/08/0A/0B/0E/13/14/15/16/18/19/20/21/22/24/25 = #03, 05 = #01",
      "apk": [
        { "file": "vendor/app/services/lock.js", "re": "0x03: 3, 0x04: 3, 0x05: 1, 0x08: 3, 0x0a: 3, 0x0b: 3, 0x0e: 3, 0x12: 3", "note": "RC_KLV 权威表 (V75/V76 勘误后)" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "0x03: 3, 0x04: 3, 0x05: 1, 0x08: 3, 0x0a: 3, 0x0b: 3, 0x0e: 3, 0x12: 3", "note": "rcKLV 逐键相同" },
        { "file": "vendor/app/services/lock.js", "re": "0x03: 3, 0x04: 3, 0x05: 1, 0x08: 3, 0x0a: 3, 0x0b: 3, 0x0e: 3, 0x12: 3", "note": "同" }
      ]
    },
    {
      "id": "L12-fp-window",
      "kind": "parity",
      "title": "13 录指纹三窗口: 首帧 8s / 两次按压 16s / 整体 150s",
      "apk": [
        { "file": "vendor/app/services/lock.js", "re": "timeout: 150000, firstFrameMs: 8000, perPressMs: 16000", "note": "_execMulti 采集窗口 (APK Java post() 只有一个 8s 计时器, 按压间隔由锁端 15s 裁定)" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "firstFrameMs: Int = 8000, perPressMs: Int = 16000", "note": "fpStart 签名" },
        { "file": "App/Services/LockService.swift", "re": "overallMs: Int = 150000", "note": "整体兜底" },
        { "file": "vendor/app/services/lock.js", "re": "timeout: 150000, firstFrameMs: 8000, perPressMs: 16000", "note": "同" }
      ]
    },
    {
      "id": "L13-open-retries-2",
      "kind": "parity",
      "title": "开锁只重试 2 次 (防电机连触发)",
      "apk": [
        { "file": "vendor/app/services/lock.js", "re": "cmd04Open\\(cred[\\s\\S]{0,80}retries: 2", "note": "G4 开锁重试降至 2" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "cmd04Open\\(cred, klv01Hex: \"0000\"\\), retries: 2", "note": "unlock" },
        { "file": "vendor/app/services/lock.js", "re": "cmd04Open\\(cred[\\s\\S]{0,60}retries: 2", "note": "同" }
      ]
    },
    {
      "id": "L14-error-codes",
      "kind": "parity",
      "title": "蓝牙错误码族 1006/1007/2003/6001/6005 与 APK 同号",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "getErrMsg\\(\"1006\"", "note": "取令牌超时" },
        { "file": "vendor/apk/BleLockConnector.java", "re": "getErrMsg\\(\"6001\"", "note": "写确认超时" },
        { "file": "vendor/apk/BleLockConnector.java", "re": "getErrMsg\\(\"6005\"", "note": "未成功发送" }
      ],
      "impl": [
        { "file": "App/Services/BLEService.swift", "re": "case ssTokenFail = 1006", "note": "" },
        { "file": "App/Services/BLEService.swift", "re": "case responseTimeout = 1007", "note": "" },
        { "file": "App/Services/BLEService.swift", "re": "case writeTimeout = 6001", "note": "" },
        { "file": "App/Services/BLEService.swift", "re": "case writeFailed = 6005", "note": "" },
        { "file": "vendor/app/services/ble.js", "re": "6001 写确认超时", "note": "" },
        { "file": "vendor/app/services/ble.js", "re": "6005 未成功发送", "note": "" }
      ]
    },
    {
      "id": "L15-scan-timeout-8s",
      "kind": "parity",
      "title": "扫描找锁 8s",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "bleScan is doing for", "note": "doCompatibleBleScan 用 BLE_TIMEOUT" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "scanForMAC\\(m, timeoutMs: 8000\\)", "note": "" },
        { "file": "vendor/app/services/ble.js", "re": "扫描超时: 8s", "note": "" }
      ]
    },
    {
      "id": "L16-token-not-truncated",
      "kind": "parity",
      "title": "令牌整串透传 (Java getToken() 原样; 不截 2B)",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "token = this\\.ssToken\\.getToken\\(\\)", "note": "" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "sessionTokenHex = k\\.val\\.lowercased\\(\\)", "note": "" },
        { "file": "vendor/app/utils/session.js", "re": "else if \\(k\\.key === 0x02\\) this\\.tokenHex = k\\.val", "note": "" }
      ]
    },
    {
      "id": "L17-serial-exec",
      "kind": "parity",
      "title": "命令串行执行 (单线程/单 waiter), 不并发抢响应",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "newSingleThreadExecutor", "note": "post() 单线程池" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "@MainActor", "note": "状态机在主 actor 上串行" },
        { "file": "vendor/app/services/lock.js", "re": "已有命令在等待响应", "note": "单 waiter" }
      ]
    },
    {
      "id": "D1-rc-minus1-failclosed",
      "kind": "divergence",
      "title": "rc=-1 (回包缺 rc KLV) 的处置",
      "apk": [
        { "file": "vendor/app/services/lock.js", "re": "r\\.rc !== 0 && r\\.rc !== -1", "note": "G5: 缺 rc 视为成功" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "if r\\.rc == -1 \\{", "note": "写命令面 fail-closed: 抛「无法确认锁端结果」" }
      ],
      "why": "本机有意收紧: 帧错位/密文解不开/固件短回包都会被 rc=-1 命中, 若按成功处理会把'没写进去'报成'已写入'。只影响写命令面, 读命令不经 execOk。"
    },
    {
      "id": "D2-write-cmd-no-resend",
      "kind": "divergence",
      "title": "写类命令超时/写失败不重发",
      "apk": [
        { "file": "vendor/app/services/lock.js", "re": "retries: 2", "note": "APK 仅把重试次数降到 2, 仍会在超时后重发" }
      ],
      "impl": [
        { "file": "App/Services/LockService.swift", "re": "ZKProtocol\\.writeCmdsBlocked\\.contains\\(cmd\\)", "note": "命中即 break, 交上层判定" }
      ],
      "why": "写失败=字节可能已到、ack 丢了, 锁已执行; 重发会造成双开门/重复录指纹。这是第二道保险, 与 L13 的 retries:2 叠加。"
    },
    {
      "id": "D3-connect-timeout",
      "kind": "divergence",
      "title": "建链超时窗口",
      "apk": [
        { "file": "vendor/apk/BleLockConnector.java", "re": "connectGatt\\(this\\.context, false", "note": "手写 scan+connect, 各 8s, 重试 3 轮" }
      ],
      "impl": [
        { "file": "App/Services/BLEService.swift", "re": "connect\\(deviceId: String, timeoutMs: Int = 20000\\)", "note": "CoreBluetooth 系统级建链, 单次 20s" }
      ],
      "why": "平台机制不同: iOS 由系统排队/重连, 没有 Android 的 startLeScan 轮次; 8s×3 无法等价移植。扫描面仍是 8s (L15)。"
    },
    {
      "id": "D4-mini-chunk-pacing",
      "kind": "divergence",
      "title": "小程序分片间 30ms 节流",
      "apk": [
        { "file": "vendor/app/services/ble.js", "re": "success: \\(\\) => setTimeout\\(next, 30\\)", "note": "APK JS 同样 30ms (wx 栈节流)" }
      ],
      "impl": [
        { "file": "vendor/app/services/ble.js", "re": "success: \\(\\) => setTimeout\\(next, 30\\)", "note": "同" }
      ],
      "why": "与 L02 超时无关: 30ms 只是 wx 写入节流, 逐片 8s 窗口才是确认超时。两边一致, 单列是因为 Java 原生层没有这一档 sleep。"
    }
  ],
  "forbid": [
    {
      "file": "App/Services/BLEService.swift",
      "re": "Thread\\.sleep|usleep|sleep\\(for",
      "why": "写路径禁止盲等: APK 用 onCharacteristicWrite 做流控, 固定 sleep 只会在弱信号下丢包 (见 L02)"
    },
    {
      "file": "App/Services/LockService.swift",
      "re": "tokenExpiryMs\\s*>\\s*Int64\\(Date",
      "why": "禁止用 TTL 缓存跳过令牌刷新 (L08: APK 每条 needToken 命令都刷)"
    },
    {
      "file": "vendor/app/services/ble.js",
      "re": "Date\\.now\\(\\) - t0 > 3000",
      "why": "整帧 3s 写超时会被 13 分片长帧在弱信号下误判 (已修为逐片 8s, 见 L02)"
    }
  ]
}
