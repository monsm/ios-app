<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  2026-10-27 新增（AUDIT-D D-44）：仓库原先没有 PrivacyInfo.xcprivacy。
	  Apple 自 2024 起要求声明 Required Reason API，缺失会被 App Store 拒收。

	  ⚠ 本文件是**草稿**：按本仓实际用到的 API 列出，但 Apple 的政策会变，
	  提交前请自行复核 https://developer.apple.com/documentation/bundleresources/privacy_manifest_files
	-->
	<key>NSPrivacyTracking</key>
	<false/>

	<!-- 不追踪任何用户，故无追踪域名 -->
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<!--
	  收集的数据类型：本 App 全部数据留在本机，不上传服务器。
	  UserDefaults 里的偏好与台账属于「App 内数据」，不是「收集的数据」，
	  按 Apple 定义（收集 = 传输到开发者服务器之外）这里为空。
	-->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>

	<!--
	  Required Reason API 申报
	  CA92.1  UserDefaults —— 仅访问本 App 自己的偏好，不跨 App 读取
	  C617.1  FileManager 时间戳 —— 仅读本 App 自己创建的文件属性
	-->
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>C617.1</string>
			</array>
		</dict>
	</dict>
</dict>
</plist>
